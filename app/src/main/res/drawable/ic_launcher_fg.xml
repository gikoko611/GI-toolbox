<?xml version="1.0" encoding="utf-8"?>
<!-- v3.0 launcher icon foreground: 3D "GI" monogram - gold G ring with neon-green crossbar,
     drop-shadow offset paths create depth. Safe-zone centered in 108dp adaptive canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- G ring shadow (offset +3y, dark gold) -->
    <path
        android:fillColor="#7A5E12"
        android:pathData="M 76.12,72.49
            A 27,27 0 1 1 76.12,41.51
            L 68.75,46.68
            A 18,18 0 1 0 68.75,67.32
            Z" />
    <!-- G ring main (gold) -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M 76.12,69.49
            A 27,27 0 1 1 76.12,38.51
            L 68.75,43.68
            A 18,18 0 1 0 68.75,64.32
            Z" />
    <!-- crossbar shadow (offset +3y, deep green) -->
    <path
        android:fillColor="#0B4A34"
        android:pathData="M 54,51.5 L 78,51.5 L 78,62.5 L 54,62.5 Z" />
    <!-- crossbar main (neon green) -->
    <path
        android:fillColor="#00FF9D"
        android:pathData="M 54,48.5 L 78,48.5 L 78,59.5 L 54,59.5 Z" />
    <!-- I dot accent (green, upper right) -->
    <path
        android:fillColor="#00FF9D"
        android:pathData="M 82,50.5 m -3,0 a 3,3 0 1 1 6,0 a 3,3 0 1 1 -6,0" />
</vector>
